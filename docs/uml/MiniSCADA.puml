@startuml MiniSCADA
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam linetype ortho
hide empty members

package "com.grupo8.scada.model" {
  abstract class Equipamento {
    - id : String
    - nome : String
    - estado : EstadoEquipamento
    - ciclosExecutados : long
    # Equipamento(id : String, nome : String)
    + ligar() : void
    + desligar() : void
    + pararEmergencia() : void
    + definirFalha() : void
    + rearmar() : boolean
    + iniciarManutencao() : void
    + concluirManutencao() : void
    + {final} ciclo() : void
    # {abstract} executarCiclo() : void
    # podeRearmar() : boolean
    # aoManterFalha() : void
    + {abstract} getTipo() : String
    + getId() : String
    + getNome() : String
    + getEstado() : EstadoEquipamento
    + getCiclosExecutados() : long
  }

  class Forno {
    - temperatura : double
    - setpoint : double
    - histerese : double
    - limiteSeguranca : double
    - resistenciaLigada : boolean
    # executarCiclo() : void
    # aoManterFalha() : void
    # podeRearmar() : boolean
    + getTipo() : String
    + ajustarSetpoint(valor : double) : void
    + getSetpoint() : double
    + gerarLeituras() : List<Leitura>
    + getTemperatura() : double
    + getHisterese() : double
    + getLimiteSeguranca() : double
    + isResistenciaLigada() : boolean
  }

  class Esteira {
    - velocidade : double
    - velocidadeMaxima : double
    - biscoitosTransportados : long
    # executarCiclo() : void
    + getTipo() : String
    + ajustarSetpoint(valor : double) : void
    + getSetpoint() : double
    + gerarLeituras() : List<Leitura>
    + getBiscoitosTransportados() : long
    + getVelocidadeMaxima() : double
  }

  class Empacotadora {
    - estoqueFilme : double
    - consumoPorCiclo : double
    - estoqueMinimo : double
    - pacotesProduzidos : long
    # executarCiclo() : void
    + getTipo() : String
    + gerarLeituras() : List<Leitura>
    + reabastecer(quantidade : double) : void
    + getEstoqueFilme() : double
    + getPacotesProduzidos() : long
    + getConsumoPorCiclo() : double
    + getEstoqueMinimo() : double
  }

  class Paletizador {
    - limiteCiclosManutencao : long
    - ciclosDesdeManutencao : long
    - caixasNoPalete : int
    - paletesConcluidos : long
    # executarCiclo() : void
    + getTipo() : String
    + precisaManutencao() : boolean
    + realizarManutencao() : void
    + gerarLeituras() : List<Leitura>
    + getCaixasNoPalete() : int
    + getPaletesConcluidos() : long
    + getLimiteCiclosManutencao() : long
  }

  class Leitura {
    - origem : String
    - grandeza : String
    - valor : double
    - unidade : String
    - limiteMinimo : double
    - limiteMaximo : double
    - instante : LocalDateTime
    + foraDoLimite() : boolean
    + getOrigem() : String
    + getGrandeza() : String
    + getValor() : double
    + getUnidade() : String
    + getInstante() : LocalDateTime
  }

  class Alarme {
    - origem : String
    - severidade : Severidade
    - mensagem : String
    - instante : LocalDateTime
    - ativo : boolean
    + Alarme(origem : String, severidade : Severidade, mensagem : String)
    + isAtivo() : boolean
    + resolver() : void
    + getOrigem() : String
    + getSeveridade() : Severidade
    + getMensagem() : String
    + getInstante() : LocalDateTime
  }

  enum EstadoEquipamento {
    PARADO
    OPERANDO
    FALHA
    MANUTENCAO
  }

  enum Severidade {
    INFO
    AVISO
    CRITICO
  }
}

package "com.grupo8.scada.model.interfaces" {
  interface Ajustavel {
    + ajustarSetpoint(valor : double) : void
    + getSetpoint() : double
  }
  interface Monitoravel {
    + gerarLeituras() : List<Leitura>
  }
  interface Manutenivel {
    + precisaManutencao() : boolean
    + realizarManutencao() : void
  }
}

package "com.grupo8.scada.service" {
  class Supervisorio {
    - equipamentos : List<Equipamento>
    - gerenciadorAlarmes : GerenciadorAlarmes
    - threadsEquipamentos : List<Thread>
    - threadMonitor : Thread
    - threadHistoriador : Thread
    - iniciado : boolean
    + iniciar() : void
    + pararEmergencia() : void
    + desligarSistema() : void
    + buscar(id : String) : Equipamento
    + realizarManutencao(id : String) : boolean
    + reabastecerEmpacotadora(id : String, quantidade : double) : boolean
    + rearmar(id : String) : boolean
    + getEquipamentos() : List<Equipamento>
    + getGerenciadorAlarmes() : GerenciadorAlarmes
    + isIniciado() : boolean
  }

  class GerenciadorAlarmes {
    - alarmes : List<Alarme>
    + registrar(novo : Alarme) : void
    + registrar(origem : String, severidade : Severidade, mensagem : String) : void
    + ativos() : List<Alarme>
    + todos() : List<Alarme>
    + resolver(origem : String, prefixoMensagem : String) : void
  }
}

package "com.grupo8.scada.threads" {
  interface Runnable <<java.lang>> {
    + run() : void
  }
  class TarefaEquipamento {
    - equipamento : Equipamento
    - intervaloMs : long
    + run() : void
  }
  class MonitorProcesso {
    - equipamentos : List<Equipamento>
    - gerenciador : GerenciadorAlarmes
    - intervaloMs : long
    + run() : void
  }
  class Historiador {
    - equipamentos : List<Equipamento>
    - registrador : RegistradorCsv
    - gerenciador : GerenciadorAlarmes
    - intervaloMs : long
    - jaRegistrados : Set<Alarme>
    + run() : void
  }
}

package "com.grupo8.scada.persistence" {
  interface "Repositorio<T>" as Repositorio {
    + carregar() : List<T>
    + salvar(itens : List<T>) : void
  }
  class RepositorioEquipamentosCsv {
    - arquivo : Path
    + carregar() : List<Equipamento>
    + salvar(itens : List<Equipamento>) : void
    - num(campos : String[], i : int) : double
  }
  class RegistradorCsv {
    - historico : Path
    - alarmes : Path
    + registrarLeituras(leituras : List<Leitura>) : void
    + registrarAlarmes(lista : List<Alarme>) : void
    - append(arquivo : Path, cabecalho : String, linha : String) : void
  }
}

package "com.grupo8.scada.ui" {
  class ConsoleOperador {
    - supervisorio : Supervisorio
    - scanner : Scanner
    + executar() : void
    - mostrarMenu() : void
    - listarEquipamentos() : void
    - ajustarSetpoint() : void
    - mostrarAlarmes() : void
    - manutencao() : void
    - rearmar() : void
    - reabastecerEmpacotadora() : void
  }
}

package "com.grupo8.scada" {
  class Main {
    + {static} main(args : String[]) : void
    - {static} criarPlantaPadrao() : List<Equipamento>
  }
}

package "com.grupo8.scada.exceptions" {
  class Exception <<java.lang>>
  class ScadaException {
    + ScadaException(mensagem : String)
    + ScadaException(mensagem : String, causa : Throwable)
  }
  class ConfiguracaoInvalidaException {
    + ConfiguracaoInvalidaException(mensagem : String)
    + ConfiguracaoInvalidaException(mensagem : String, causa : Throwable)
  }
  class EquipamentoEmFalhaException {
    + EquipamentoEmFalhaException(mensagem : String)
  }
  class SetpointInvalidoException {
    + SetpointInvalidoException(mensagem : String)
  }
}

' herança
Equipamento <|-- Forno
Equipamento <|-- Esteira
Equipamento <|-- Empacotadora
Equipamento <|-- Paletizador
Exception <|-- ScadaException
ScadaException <|-- ConfiguracaoInvalidaException
ScadaException <|-- EquipamentoEmFalhaException
ScadaException <|-- SetpointInvalidoException

' realização de interfaces
Ajustavel <|.. Forno
Ajustavel <|.. Esteira
Monitoravel <|.. Forno
Monitoravel <|.. Esteira
Monitoravel <|.. Empacotadora
Monitoravel <|.. Paletizador
Manutenivel <|.. Paletizador
Repositorio <|.. RepositorioEquipamentosCsv
Runnable <|.. TarefaEquipamento
Runnable <|.. MonitorProcesso
Runnable <|.. Historiador

' associações
Equipamento --> EstadoEquipamento : estado
Alarme --> Severidade : severidade
Supervisorio o-- "0..*" Equipamento : equipamentos
Supervisorio o-- "1" GerenciadorAlarmes
GerenciadorAlarmes o-- "0..*" Alarme
ConsoleOperador --> Supervisorio
TarefaEquipamento --> Equipamento : executa ciclo
MonitorProcesso --> Equipamento : monitora
MonitorProcesso --> GerenciadorAlarmes : registra alarmes
Historiador --> Equipamento : lê
Historiador --> GerenciadorAlarmes : lê alarmes
Historiador --> RegistradorCsv : grava

' dependências
Supervisorio ..> TarefaEquipamento : cria
Supervisorio ..> MonitorProcesso : cria
Supervisorio ..> Historiador : cria
Supervisorio ..> RegistradorCsv : cria
Main ..> RepositorioEquipamentosCsv : usa
Main ..> Supervisorio : cria
Main ..> GerenciadorAlarmes : cria
Main ..> ConsoleOperador : cria
RepositorioEquipamentosCsv ..> Equipamento : cria
RepositorioEquipamentosCsv ..> ConfiguracaoInvalidaException : lança
Equipamento ..> EquipamentoEmFalhaException : lança
Ajustavel ..> SetpointInvalidoException : lança
Monitoravel ..> Leitura : produz
MonitorProcesso ..> Leitura : avalia
Historiador ..> Leitura : registra
RegistradorCsv ..> Leitura : grava
RegistradorCsv ..> Alarme : grava
@enduml
